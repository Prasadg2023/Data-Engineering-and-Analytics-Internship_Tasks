     ]
    }
   ],
   "source": [
    "import copy\n",
    "\n",
    "a = [[1, 2], [3, 4]]\n",
    "b = copy.deepcopy(a)\n",
    "b[0][1] = 99\n",
    "print(a)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "05423b31-3767-4811-a29b-cfc330d9e701",
   "metadata": {},
   "source": [
    "#### Output: [[1, 2], [3, 4]]\n",
    "#### Explanation: deepcopy() creates a separate copy\n",
    "#### So changing b does not change a"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3061dc94-86b9-4802-8cd3-1109a47c6a00",
   "metadata": {},
