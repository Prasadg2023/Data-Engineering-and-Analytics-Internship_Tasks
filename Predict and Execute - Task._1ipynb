     "output_type": "stream",
     "text": [
      "[[1, 99], [3, 4]]\n"
     ]
    }
   ],
   "source": [
    "import copy\n",
    "\n",
    "a = [[1, 2], [3, 4]]\n",
    "b = copy.copy(a)\n",
    "b[0][1] = 99\n",
    "print(a)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bf39ba7c-1e23-4769-bd54-13517ed6ee7d",
   "metadata": {},
   "source": [
    "#### Output: [[1, 99], [3, 4]]\n",
    "#### Explanation: The nested lists are shared by both a and b\n",
    "#### So changing b also changes a"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "623f6a10-97b0-47f3-8fb3-a81528d59cf1",
   "metadata": {},
   "source": [
